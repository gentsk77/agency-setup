#!/bin/sh
# agency-setup D7: main is PR-only. Block direct commits on the trunk.
# Enable once per clone: git config core.hooksPath scripts/hooks
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "blocked: '$branch' is PR-only (D7). Work on a branch and open a PR." >&2
  echo "  git switch -c feat/your-change" >&2
  echo "(genuine emergency override: git commit --no-verify)" >&2
  exit 1
fi
exit 0
